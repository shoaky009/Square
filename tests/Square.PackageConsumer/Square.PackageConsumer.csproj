<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Square" />
    <PackageReference Include="Square.Compiler" PrivateAssets="all" />
    <PackageReference Include="Square.Platform.Win32" Condition="'$(SquareTargetPlatform)' == 'Win32'" />
    <PackageReference Include="Square.Platform.X11" Condition="'$(SquareTargetPlatform)' == 'X11'" />
  </ItemGroup>
</Project>
