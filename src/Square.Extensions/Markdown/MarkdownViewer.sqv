<template>
  <View ref="Root" class="markdown-viewer" />
</template>
<script lang="csharp" namespace="Square.Extensions.Markdown">
  [Prop]
  public string Content
  {
    get => GetProperty<string>(nameof(Content)) ?? GetProperty<string>("content") ?? "";
    set => SetProperty(nameof(Content), value ?? "");
  }

  [Prop]
  public string Markdown
  {
    get => Content;
    set => Content = value;
  }

  [Prop]
  public MarkdownDocument? SourceDocument
  {
    get => GetProperty<MarkdownDocument>(nameof(SourceDocument));
    set => SetProperty(nameof(SourceDocument), value);
  }

  public MarkdownDocument Document { get; private set; } = MarkdownDocument.Empty;

  private string? _parsedContent;
  private MarkdownDocument? _renderedSourceDocument;

  protected override void OnPropChanged(string name)
  {
    base.OnPropChanged(name);
    if (name == nameof(Content) || name == nameof(Markdown) || name == nameof(SourceDocument))
      RenderMarkdown();
  }

  protected override void OnAttachedCore()
  {
    base.OnAttachedCore();
    RenderMarkdown();
  }

  private void RenderMarkdown()
  {
    var sourceDocument = SourceDocument;
    if (sourceDocument != null)
    {
      if (!ReferenceEquals(_renderedSourceDocument, sourceDocument))
      {
        Document = sourceDocument;
        _renderedSourceDocument = sourceDocument;
      }
    }
    else
    {
      var content = Content;
      if (_renderedSourceDocument != null || !string.Equals(_parsedContent, content, StringComparison.Ordinal))
      {
        Document = MarkdownDocument.Parse(content);
        _parsedContent = content;
        _renderedSourceDocument = null;
      }
    }
    if (Root == null) return;
    MarkdownRenderer.Render(Document, Root);
  }
</script>
<style>
  .markdown-viewer { display: flex; flex-direction: column; gap: 8px; color: #202124; user-select: text; }
  .markdown-inline-block { display: flex; flex-direction: row; flex-wrap: wrap; }
  .markdown-heading-1 { font-size: 28px; line-height: 35px; color: #111827; margin-bottom: 4px; }
  .markdown-heading-2 { font-size: 24px; line-height: 30px; color: #111827; margin-bottom: 4px; }
  .markdown-heading-3 { font-size: 20px; line-height: 25px; color: #111827; margin-bottom: 2px; }
  .markdown-heading-4 { font-size: 18px; line-height: 23px; color: #111827; }
  .markdown-heading-5 { font-size: 16px; line-height: 20px; color: #111827; }
  .markdown-heading-6 { font-size: 14px; line-height: 18px; color: #374151; }
  .markdown-paragraph { color: #374151; font-size: 14px; line-height: 22px; }
  .markdown-list { display: flex; flex-direction: column; gap: 6px; padding-left: 8px; }
  .markdown-list-item { display: flex; flex-direction: row; align-items: flex-start; gap: 8px; color: #212529; font-size: 14px; line-height: 22px; }
  .markdown-list-marker { min-width: 18px; color: #6c757d; font-size: 14px; line-height: 22px; text-align: right; }
  .markdown-task-marker { width: 20px; height: 22px; min-width: 20px; }
  .markdown-list-content { display: flex; flex-direction: column; gap: 4px; flex-grow: 1; min-width: 0; }
  .markdown-container { display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
  .markdown-quote { display: flex; flex-direction: column; gap: 6px; background: #f3f4f6; color: #4b5563; padding: 8px 10px; }
  .markdown-code { display: flex; flex-direction: column; width: 100%; box-sizing: border-box; overflow: hidden; background: #f8f9fa; padding: 12px 16px; border: 1px solid #dee2e6; border-radius: 4px; }
  .markdown-code-text { color: #212529; font-family: monospace; font-size: 13px; line-height: 20px; }
  .markdown-inline-code { display: flex; flex-direction: row; align-items: center; background: #f1f3f5; padding: 1px 5px; border: 1px solid #e9ecef; border-radius: 3px; }
  .markdown-inline-code-text { color: #d63384; font-family: monospace; font-size: 13px; line-height: 18px; }
  .markdown-link { color: #175cd3; }
  .markdown-image { max-width: 100%; min-width: 0; }
  .markdown-bold { font-weight: bold; }
  .markdown-italic { font-style: italic; }
  .markdown-strikethrough { text-decoration: line-through; }
  .markdown-separator { height: 1px; background: #e5e7eb; }
  .markdown-table { display: flex; flex-direction: column; width: 100%; border: 1px solid #dee2e6; border-radius: 4px; overflow: hidden; background: #ffffff; }
  .markdown-table-row { display: flex; flex-direction: row; align-items: stretch; border-bottom: 1px solid #dee2e6; }
  .markdown-table-row:last-child { border-bottom-width: 0; }
  .markdown-table-row:nth-child(even) { background: #f8f9fa; }
  .markdown-table-cell { display: flex; flex-direction: column; justify-content: center; gap: 4px; min-width: 0; flex-grow: 0; flex-shrink: 0; box-sizing: border-box; padding: 10px 12px; border-right: 1px solid #dee2e6; color: #212529; font-size: 14px; line-height: 21px; }
  .markdown-table-cell:last-child { border-right-width: 0; }
  .markdown-table-header { background: #e9ecef; color: #212529; font-weight: bold; }
  .markdown-table-cell .markdown-paragraph { color: #212529; font-size: 14px; line-height: 21px; }
  .markdown-align-left { text-align: left; }
  .markdown-align-center { text-align: center; }
  .markdown-align-right { text-align: right; }
</style>
