<template>
  <View class="tabs">
    <View ref="TabList" class="tab-list">
      <Slot name="tabs">
        <Text class="tabs-fallback" text="No tabs" />
      </Slot>
    </View>
    <View ref="PanelHost" class="tab-panels">
    </View>
  </View>
</template>
<script lang="csharp">
  private readonly List<(Button Button, Action Handler)> _tabHandlers = [];
  private Button[] _tabButtons = [];
  private string[] _tabPaths = [];
  private Square.Router.Router? _router;
  private bool _tabsReady;
  private bool _syncingRoute;

  [Prop]
  public string[] Paths
  {
    get => GetProperty<string[]>(nameof(Paths)) ?? GetProperty<string[]>("paths") ?? [];
    set => SetProperty(nameof(Paths), value ?? []);
  }

  [Prop]
  public string InitialPath
  {
    get => GetProperty<string>(nameof(InitialPath)) ?? GetProperty<string>("initialPath") ?? "";
    set => SetProperty(nameof(InitialPath), value ?? "");
  }

  [Prop]
  public Func<UIElement>[] PageFactories
  {
    get => GetProperty<Func<UIElement>[]>(nameof(PageFactories)) ?? GetProperty<Func<UIElement>[]>("pageFactories") ?? [];
    set => SetProperty(nameof(PageFactories), value ?? []);
  }

  public int SelectedIndex
  {
    get => GetProperty<int>(nameof(SelectedIndex));
    set => SetProperty(nameof(SelectedIndex), value);
  }

  protected override void OnAttachedCore()
  {
    _tabButtons = TabList.Children.OfType<Button>().ToArray();
    if (_router == null)
    {
      var pairCount = Math.Min(_tabButtons.Length, PageFactories.Length);
      _tabPaths = new string[pairCount];
      _router = new Square.Router.Router { InitialPath = ResolveInitialPath(pairCount) };
      _router.ClassList.Add("tab-router");
      for (var i = 0; i < pairCount; i++)
      {
        var pageFactory = PageFactories[i];
        var path = Paths.Length == pairCount ? NormalizePath(Paths[i]) : "/tabs/" + i;
        _tabPaths[i] = path;
        _router.Routes.Add(new Square.Router.RouteDefinition(path, pageFactory));
      }
      PanelHost.Children.Add(_router);
    }
    _router.Navigated += OnNavigated;

    for (var i = 0; i < _tabButtons.Length; i++)
    {
      var index = i;
      Action handler = () => Select(index);
      _tabButtons[i].AddEventListener("click", handler);
      _tabHandlers.Add((_tabButtons[i], handler));
    }

    _tabsReady = true;
  }

  protected override void OnDetachedCore()
  {
    foreach (var entry in _tabHandlers)
      entry.Button.RemoveEventListener("click", entry.Handler);
    _tabHandlers.Clear();
    if (_router != null) _router.Navigated -= OnNavigated;
    _tabsReady = false;
  }

  protected override void OnPropertyChanged(string name)
  {
    base.OnPropertyChanged(name);
    if (name == nameof(SelectedIndex) && _tabsReady && !_syncingRoute) NavigateTo(SelectedIndex);
  }

  private void Select(int index)
  {
    if (index == SelectedIndex) return;
    if (NavigateTo(index)) DispatchEvent(StandardEvents.CreateChange());
  }

  private bool NavigateTo(int index)
  {
    if (_router == null || _tabPaths.Length == 0) return false;
    var selected = Math.Clamp(index, 0, _tabPaths.Length - 1);
    return _router.Navigate(_tabPaths[selected]);
  }

  private void OnNavigated(Square.Router.RouteContext route)
  {
    var selected = Array.FindIndex(_tabPaths, path => string.Equals(path, route.Path, StringComparison.Ordinal));
    if (selected < 0) return;
    _syncingRoute = true;
    try
    {
      SelectedIndex = selected;
    }
    finally
    {
      _syncingRoute = false;
    }

    for (var i = 0; i < _tabButtons.Length; i++)
    {
      var isSelected = i == selected;
      _tabButtons[i].ClassList.Toggle("selected", isSelected);
      _tabButtons[i].Style.Set("background", isSelected ? "#ffffff" : "#eef1f4");
      _tabButtons[i].Style.Set("color", isSelected ? "#005ea6" : "#454b52");
    }
  }

  private string ResolveInitialPath(int pairCount)
  {
    if (!string.IsNullOrWhiteSpace(InitialPath)) return NormalizePath(InitialPath);
    if (pairCount == 0) return "/";
    var selected = Math.Clamp(SelectedIndex, 0, pairCount - 1);
    return Paths.Length == pairCount ? NormalizePath(Paths[selected]) : "/tabs/" + selected;
  }

  private static string NormalizePath(string path) =>
    string.IsNullOrWhiteSpace(path) ? "/" : path.StartsWith("/", StringComparison.Ordinal) ? path : "/" + path;
</script>
<style>
  .tabs { display: flex; flex-direction: column; gap: 0; padding: 0; height: 850px; }
  .tab-list { display: flex; flex-direction: row; gap: 2px; padding: 0; height: 42px; background: #eef1f4; }
  .tab-button { height: 42px; background: #eef1f4; color: #454b52; }
  .tab-button.selected { background: #ffffff; color: #005ea6; }
  .tab-panels { padding: 16px 0 0; height: 792px; overflow-y: auto; }
  .tab-router { width: 100%; min-height: 100%; }
  .tabs-fallback { color: #667085; font-size: 14px; }
</style>
