<template>
  <View class="media-page sample-page">
    <Text class="page-title" text="Image and Canvas" />
    <Image :image="PreviewImage" source="Generated image" />
    <Canvas ref="DemoCanvas" />
  </View>
</template>
<script lang="csharp">
  public ObservableValue<Square.Graphics.Image?> PreviewImage = new(CreatePreviewImage());
  private readonly Square.Controls.Animation.Clock _clock = new();
  private Square.Controls.Animation.Animation<float>? _introAnimation;
  private Square.Controls.Animation.Animation<float>? _secondSweepAnimation;
  private float _introProgress;
  private float _secondSweep;
  private int _animatedSecond = -1;
  private double _lastFrameSeconds;
  private const double ClockFps = 20d;

  protected override void OnAttachedCore()
  {
    _clock.Start();
    _lastFrameSeconds = 0;
    _introProgress = 0;
    _secondSweep = 0;
    _animatedSecond = -1;
    _introAnimation = new Square.Controls.Animation.Animation<float>(
      Interpolate,
      0f,
      1f,
      0.85f,
      t => 1f - MathF.Pow(1f - t, 3f),
      value => _introProgress = value);
    _introAnimation.Start();
    DemoCanvas.RequestAnimationFrame(DrawClock, ClockFps);
  }

  protected override void OnDetachedCore()
  {
    _clock.Stop();
    _introAnimation?.Stop();
    _secondSweepAnimation?.Stop();
  }

  private void DrawClock(IRenderContext context, Rect bounds)
  {
    var elapsed = _clock.ElapsedSeconds;
    var delta = _lastFrameSeconds <= 0 ? 0 : elapsed - _lastFrameSeconds;
    _lastFrameSeconds = elapsed;
    var frameDelta = (float)Math.Min(delta, 0.05d);
    _introAnimation?.Update(frameDelta);
    _secondSweepAnimation?.Update(frameDelta);

    var center = new Point(bounds.X + bounds.Width / 2f, bounds.Y + bounds.Height / 2f);
    var radius = MathF.Max(20f, MathF.Min(bounds.Width, bounds.Height) / 2f - 18f);
    var face = new EllipseGeometry(center, radius, radius);
    context.FillGeometry(face, new SolidColorBrush(Color.FromRgb(248, 250, 252)));
    context.DrawGeometry(face, Pen.FromColor(Color.FromRgb(60, 67, 74), 2f));

    for (var i = 0; i < 60; i++)
    {
      var angle = i * MathF.Tau / 60f - MathF.PI / 2f;
      var major = i % 5 == 0;
      var outer = PointOnClock(center, radius - 5f, angle);
      var inner = PointOnClock(center, radius - (major ? 17f : 10f), angle);
      context.DrawPath(
        PathGeometry.Create().MoveTo(inner).LineTo(outer),
        Pen.FromColor(major ? Color.FromRgb(45, 52, 59) : Color.FromRgb(145, 151, 157), major ? 2f : 1f));
    }

    var now = DateTime.Now.TimeOfDay;
    var second = (int)Math.Floor(now.TotalSeconds) % 60;
    if (second != _animatedSecond)
    {
      _animatedSecond = second;
      _secondSweep = 0;
      _secondSweepAnimation?.Stop();
      _secondSweepAnimation = new Square.Controls.Animation.Animation<float>(
        Interpolate,
        0f,
        1f,
        0.24f,
        t => 1f - MathF.Pow(1f - t, 4f),
        value => _secondSweep = value);
      _secondSweepAnimation.Start();
    }

    var secondAngle = ToClockAngle((second + _secondSweep) / 60d);
    var minuteAngle = ToClockAngle((now.TotalMinutes % 60d) / 60d);
    var hourAngle = ToClockAngle((now.TotalHours % 12d) / 12d);
    var reveal = Math.Clamp(_introProgress, 0f, 1f);

    DrawHand(context, center, radius * 0.52f * reveal, hourAngle, Color.FromRgb(35, 42, 48), 5f);
    DrawHand(context, center, radius * 0.72f * reveal, minuteAngle, Color.FromRgb(35, 42, 48), 3f);
    DrawHand(context, center, radius * 0.82f * reveal, secondAngle, Color.FromRgb(210, 48, 58), 1.5f);
    context.FillGeometry(
      new EllipseGeometry(center, 5f + 2f * (1f - reveal), 5f + 2f * (1f - reveal)),
      new SolidColorBrush(Color.FromRgb(210, 48, 58)));

    DemoCanvas.RequestAnimationFrame(DrawClock, ClockFps);
  }

  private static void DrawHand(IRenderContext context, Point center, float length, float angle, Color color, float width)
  {
    if (length <= 0.1f) return;
    context.DrawPath(
      PathGeometry.Create().MoveTo(center).LineTo(PointOnClock(center, length, angle)),
      Pen.FromColor(color, width));
  }

  private static float ToClockAngle(double turn) => (float)(turn * Math.Tau - Math.PI / 2d);

  private static float Interpolate(float from, float to, float t) => from + (to - from) * t;

  private static Point PointOnClock(Point center, float radius, float angle) =>
    new(center.X + MathF.Cos(angle) * radius, center.Y + MathF.Sin(angle) * radius);

  private static Bitmap CreatePreviewImage()
  {
    var bitmap = new Bitmap(320, 120);
    for (var y = 0; y < bitmap.Height; y++)
    {
      for (var x = 0; x < bitmap.Width; x++)
      {
        var index = y * bitmap.Stride + x * 4;
        bitmap.Pixels[index] = (byte)(210 - y);
        bitmap.Pixels[index + 1] = (byte)(80 + x * 120 / bitmap.Width);
        bitmap.Pixels[index + 2] = (byte)(30 + x * 180 / bitmap.Width);
        bitmap.Pixels[index + 3] = 255;
      }
    }
    return bitmap;
  }
</script>
<style>
  .sample-page { display: flex; flex-direction: column; gap: 12px; padding: 0; }
  .page-title { color: #202124; font-size: 18px; }
  .media-page Image { height: 120px; }
  .media-page Canvas { height: 260px; }
</style>
