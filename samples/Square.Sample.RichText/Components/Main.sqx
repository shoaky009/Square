<template>
  <View class="app-shell">
    <View class="status-row">
      <View class="page-heading">
        <Text class="eyebrow" text="SQUARE EXTENSIONS" />
        <Text class="app-subtitle" text="Rich text editing workspace" />
      </View>
      <Text ref={StatusLabel} class="status" text="Ready" />
    </View>

    <View class="workspace">
      <View class="editor-pane">
        <View class="pane-heading">
          <Text class="pane-label" text="DOCUMENT" />
          <Text class="pane-hint" text="Select text, then use the title-bar menus" />
        </View>
        <RichTextEditor ref={Editor} class="rich-editor" onInput={OnEditorInput} />
      </View>
      <View class="preview-pane">
        <View class="pane-heading">
          <Text class="pane-label" text="PLAIN TEXT" />
          <Text class="pane-hint" text="Live document projection" />
        </View>
        <View class="preview-scroll">
          <Text ref={PreviewText} class="preview-text" text="" />
        </View>
        <Text ref={SelectionText} class="selection-text" text="Selection: none" />
      </View>
    </View>
  </View>
</template>
<script lang="csharp">
  private string _richClipboard = "";

  protected override void OnAttachedCore()
  {
    base.OnAttachedCore();
    LoadSample();
    SetStatus("Ready");
  }

  internal void OnUndo()
  {
    SetStatus(Editor.Undo() ? "Undo applied" : "Nothing to undo");
    RefreshInspector();
  }

  internal void OnRedo()
  {
    SetStatus(Editor.Redo() ? "Redo applied" : "Nothing to redo");
    RefreshInspector();
  }

  internal void OnBold()
  {
    Editor.ToggleBold();
    SetStatus("Bold toggled");
    RefreshInspector();
  }

  internal void OnItalic()
  {
    Editor.ToggleItalic();
    SetStatus("Italic toggled");
    RefreshInspector();
  }

  internal void OnUnderline()
  {
    Editor.ToggleUnderline();
    SetStatus("Underline toggled");
    RefreshInspector();
  }

  internal void OnClearFormatting()
  {
    Editor.ClearFormatting();
    SetStatus("Formatting cleared");
    RefreshInspector();
  }

  internal void OnBlue() => ApplyColor("#175cd3", "Blue applied");
  internal void OnRed() => ApplyColor("#b42318", "Red applied");
  internal void OnGreen() => ApplyColor("#067647", "Green applied");

  private void ApplyColor(string color, string status)
  {
    Editor.SetForeground(color);
    SetStatus(status);
    RefreshInspector();
  }

  internal void OnSelectAll()
  {
    Editor.SelectAll();
    SetStatus("Document selected");
    RefreshInspector();
  }

  internal void OnCopyRich()
  {
    if (Editor.SelectionLength == 0)
    {
      SetStatus("Select text before copying rich content");
      return;
    }
    _richClipboard = Editor.GetSelectedRichText();
    SetStatus("Rich fragment copied to demo buffer");
  }

  internal void OnPasteRich()
  {
    if (string.IsNullOrEmpty(_richClipboard))
    {
      SetStatus("Rich clipboard is empty");
      return;
    }
    SetStatus(Editor.InsertRichText(_richClipboard) ? "Rich fragment pasted" : "Rich fragment is invalid");
    RefreshInspector();
  }

  internal void OnLoadSample()
  {
    LoadSample();
    SetStatus("Sample loaded");
  }

  private void LoadSample()
  {
    Editor.PlainText = "Square RichText Editor\n\nSelect any text and apply formatting from the title-bar menus.\nThe editor supports multiple paragraphs, soft wrapping, pointer selection, undo and redo.\n\n中文、English and full-width characters can be edited together.";
    Editor.SelectAll();
    Editor.ClearFormatting();
    Editor.CollapseSelectionToEnd();
    RefreshInspector();
  }

  internal void OnClear()
  {
    Editor.PlainText = "";
    SetStatus("Document cleared");
    RefreshInspector();
  }

  private void OnEditorInput()
  {
    SetStatus("Document changed");
    RefreshInspector();
  }

  private void RefreshInspector()
  {
    PreviewText.TextContent = Editor.PlainText;
    SelectionText.TextContent = Editor.SelectionLength == 0
      ? "Selection: none"
      : "Selection: " + Editor.SelectionLength + " characters";
  }

  private void SetStatus(string text)
  {
    StatusLabel.TextContent = text;
  }
</script>
<style>
  .app-shell { display: flex; flex-direction: column; width: 100%; height: 100%; gap: 14px; padding: 22px; background: #e8edf4; overflow: hidden; }
  .status-row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
  .page-heading { display: flex; flex-direction: column; gap: 3px; }
  .eyebrow { color: #2563a8; font-size: 11px; font-weight: 700; }
  .app-subtitle { color: #344054; font-size: 18px; font-weight: 700; }
  .status { color: #175b45; font-size: 12px; background: #dff6ec; padding: 7px 12px; border: 1px solid #a7dfcb; }
  .workspace { display: flex; flex-direction: row; gap: 16px; min-height: 0; flex-grow: 1; align-items: stretch; }
  .editor-pane { display: flex; flex-direction: column; gap: 10px; flex: 2 1 0; min-width: 0; min-height: 0; padding: 16px; background: #f8fafc; border: 1px solid #c9d3e0; overflow: hidden; }
  .preview-pane { display: flex; flex-direction: column; gap: 10px; flex: 1 1 0; min-width: 0; min-height: 0; padding: 16px; background: #f3f6fa; border: 1px solid #c9d3e0; overflow: hidden; }
  .pane-heading { display: flex; flex-direction: column; gap: 2px; }
  .pane-label { color: #172033; font-size: 12px; font-weight: 700; }
  .pane-hint { color: #7b8798; font-size: 11px; }
  .rich-editor { min-height: 180px; flex-grow: 1; flex-shrink: 1; align-self: stretch; font-size: 16px; color: #101828; background: #ffffff; border: 1px solid #d7dee8; padding: 18px; }
  .rich-editor::selection { background: #3390ff; color: #ffffff; }
  .preview-scroll { min-width: 0; min-height: 0; flex-grow: 1; flex-shrink: 1; align-self: stretch; overflow-y: auto; overflow-x: hidden; }
  .preview-text { min-width: 0; align-self: stretch; color: #3d4b5f; font-size: 14px; line-height: 23px; user-select: text; }
  .selection-text { height: 54px; min-width: 0; flex-shrink: 0; align-self: stretch; color: #526174; font-size: 12px; background: #e6ebf2; padding: 9px; border: 1px solid #d2dae5; overflow: hidden; }
</style>
