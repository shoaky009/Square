<template>
  <View class="signal-subscriber signal-section">
    <Text class="signal-title" text="Subscriber component" />
    <Text class="signal-value" text={Received} />
    <Text class="signal-thread" text={DeliveryThread} />
  </View>
</template>
<script lang="csharp">
  public ObservableValue<string> Received = new("Waiting for a signal");
  public ObservableValue<string> DeliveryThread = new("UI dispatcher idle");
  private IDisposable? _subscription;

  protected override void OnAttachedCore()
  {
    _subscription?.Dispose();
    _subscription = SampleSignals.Activity.Subscribe(value =>
    {
      Received.Value = value;
      DeliveryThread.Value = "Delivered on UI thread " + Environment.CurrentManagedThreadId;
    }, SampleSignals.UiDispatcher, emitCurrent: true);
  }

  protected override void OnDetachedCore()
  {
    _subscription?.Dispose();
    _subscription = null;
  }
</script>
<style>
  .signal-section { display: flex; flex-direction: column; gap: 10px; padding: 14px; background: #f5f7f9; }
  .signal-title { color: #202124; font-size: 16px; }
  .signal-value { color: #067647; font-size: 18px; }
  .signal-thread { color: #555b61; font-size: 14px; }
</style>
