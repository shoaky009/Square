<sqx>
  <template>
    <View>
      <Text text="Hello Square" />
      <Button ref={MyBtn} onClick={OnClick}>
        Click Me
      </Button>
      <Show when={ShowCount}>
        <Text text="You clicked!" />
      </Show>
    </View>
  </template>
  <script lang="csharp">
    private int _count = 0;
    public ObservableValue<bool> ShowCount = new(false);

    private void OnClick()
    {
      _count++;
    }
  </script>
  <style>
    View { padding: 16px; display: flex; flex-direction: column; gap: 8px; }
    Text { color: #333; font-size: 24px; }
    Button { background: #0078d4; color: #ffffff; }
  </style>
</sqx>